@model NIA_4_CRM.Models.Member

@{
    ViewData["Title"] = "Delete";
}

<h1 class="display-4 text-center my-4">Delete Member</h1>
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-header bg-danger text-white">
                    <h3 class="card-title mb-0">Are you sure you want to delete this?</h3>
                </div>
                <div class="card-body">
                    <h4>Member Details</h4>
                    <hr />
                    <dl class="row">
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.Organization)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.Organization.City)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.MembershipStartDate)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.MembershipStartDate)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.MembershipRenewDate)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.MembershipRenewDate)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.MembershipType)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.MembershipType.MembershipName)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.Contact)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.Contact.Email)
                        </dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Status)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Status)</dd>
                    </dl>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" asp-for="Id" />
                        <input type="submit" value="Delete" class="btn btn-danger btn-lg rounded-pill custom-btn" />
                    </form>
                    <a asp-action="Index" class="btn btn-secondary btn-lg rounded-pill custom-btn">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>