@model IEnumerable<NIA_4_CRM.Models.Member>

@{
    ViewData["Title"] = "Index";
}

<h1 class="display-4 text-center my-4">Members List</h1>

<div class="container">
    <div class="row mb-3">
        <div class="col text-right">
            <a asp-action="Create" class="btn btn-danger btn-lg rounded-pill custom-btn">Create New</a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered table-hover shadow-lg">
            <thead class="thead-dark">
                <tr>
                    <th class="name-column">@Html.DisplayNameFor(model => model.First().Organization.OrgName)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Organization.StateProvince)</th>
                    <th>@Html.DisplayNameFor(model => model.First().MembershipStartDate)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Status)</th>
                    <th class="phone-column">@Html.DisplayNameFor(model => model.First().Organization.PhoneNumber)</th>
                    <th>@Html.DisplayNameFor(model => model.First().MembershipType.MembershipName)</th>
                    <th class="name-column">@Html.DisplayNameFor(model => model.First().Contact.FullName)</th>
                    <th class="email-column">@Html.DisplayNameFor(model => model.First().Contact.Email)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="name-column">@Html.DisplayFor(modelItem => item.Organization.OrgName)</td>
                        <td>@Html.DisplayFor(modelItem => item.Organization.StateProvince)</td>
                        <td>@Html.DisplayFor(modelItem => item.MembershipStartDate)</td>
                        <td>@Html.DisplayFor(modelItem => item.Status)</td>
                        <td class="phone-column">@Html.DisplayFor(modelItem => item.Organization.PhoneNumber)</td>
                        <td>@Html.DisplayFor(modelItem => item.MembershipType.MembershipName)</td>
                        <td class="name-column">@Html.DisplayFor(modelItem => item.Contact.FullName)</td>
                        <td class="email-column">@Html.DisplayFor(modelItem => item.Contact.Email)</td>
                        <td class="text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm action-btn">Details</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm action-btn">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm action-btn">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>