@model NIA_4_CRM.Models.Contact

@{
    ViewData["Title"] = "Details";
}

<h1 class="display-4 text-center my-4">Contact Details</h1>
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-header bg-danger text-white">
                    <h3 class="card-title mb-0">Details</h3>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FirstName)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.FirstName)</dd>
                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.MiddleName)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.MiddleName)</dd>
                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.LastName)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.LastName)</dd>
                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Phone)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Phone)</dd>
                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Email)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Email)</dd>
                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DOB)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.DOB)</dd>
                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PostalCode)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.PostalCode)</dd>
                    </dl>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    
                    <a asp-action="Edit" asp-route-id="@Model?.ID" class="btn btn-danger btn-lg rounded-pill custom-btn">Edit</a>
                    <a asp-action="Index" class="btn btn-secondary btn-lg rounded-pill custom-btn">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>