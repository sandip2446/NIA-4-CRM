@model IEnumerable<NIA_4_CRM.Models.Organization>

@{
    ViewData["Title"] = "Index";
}

<h1 class="display-4 text-center my-4">Business List</h1>

<div class="container">
    <div class="row mb-3">
        <div class="col text-right">
            <a asp-action="Create" class="btn btn-danger btn-lg rounded-pill custom-btn">Create New</a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered table-hover shadow-lg">
            <thead class="thead-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.First().OrgName)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Website)</th>
                    <th>@Html.DisplayNameFor(model => model.First().Email)</th>
                    <th>@Html.DisplayNameFor(model => model.First().PhoneNumber)</th>
                    <th>@Html.DisplayNameFor(model => model.First().IndustryType.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.First().StreetAddress)</th>
                    <th>@Html.DisplayNameFor(model => model.First().City)</th>
                    <th>@Html.DisplayNameFor(model => model.First().StateProvince)</th>
                    <th>@Html.DisplayNameFor(model => model.First().PostalCode)</th>
                    <th>@Html.DisplayNameFor(model => model.First().DOI)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.OrgName)</td>
                        <td>@Html.DisplayFor(modelItem => item.Website)</td>
                        <td>@Html.DisplayFor(modelItem => item.Email)</td>
                        <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                        <td>@Html.DisplayFor(modelItem => item.IndustryType.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.StreetAddress)</td>
                        <td>@Html.DisplayFor(modelItem => item.City)</td>
                        <td>@Html.DisplayFor(modelItem => item.StateProvince)</td>
                        <td>@Html.DisplayFor(modelItem => item.PostalCode)</td>
                        <td>@Html.DisplayFor(modelItem => item.DOI)</td>
                        <td class="text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm action-btn">Details</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm action-btn">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm action-btn">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>